<d:EngineDocument x:Class="Dino2.Desktop.MultiTwoStrokeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="clr-namespace:Dino2.Desktop"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:ic="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Style="{StaticResource Dino2.Window}" Title="Dino2 · Multicilíndrico 2T" Width="1330" Height="875" MinWidth="820" MinHeight="520">
  <mah:MetroWindow.IconTemplate>
    <DataTemplate><ic:PackIconMaterial Kind="ViewParallelOutline" Width="18" Height="18" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White"/></DataTemplate>
  </mah:MetroWindow.IconTemplate>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource Dino2.Brushes.Panel}" BorderBrush="{StaticResource Dino2.Brushes.Border}" BorderThickness="0,0,0,1">
      <WrapPanel x:Name="Commands" Style="{StaticResource Dino2.CommandBar}">
        <StackPanel Style="{StaticResource Dino2.CommandGroup}" ToolTipService.ToolTip="Archivo">
          <Button x:Name="M2Open" Click="Open_Click" ToolTip="Abrir proyecto 2T multicilíndrico (Ctrl+O)">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="FolderOpenOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Abrir…"/></StackPanel></Button>
          <Button x:Name="M2Save" Click="Save_Click" ToolTip="Guardar proyecto (Ctrl+S)">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="ContentSaveOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Guardar…"/></StackPanel></Button>
          <Button x:Name="M2Export" Click="Export_Click" ToolTip="Exportar resultados a CSV (Ctrl+E)">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="FileDelimitedOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Exportar…"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Style="{StaticResource Dino2.CommandGroup}" ToolTipService.ToolTip="Simulación"><Border Style="{StaticResource Dino2.CommandSeparator}"/>
          <Button x:Name="M2Run" Click="Run_Click" Style="{StaticResource Dino2.Button.Primary}" Margin="0" ToolTip="Simular el motor acoplado (F5)">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="Play" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Simular"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Style="{StaticResource Dino2.CommandGroup}" ToolTipService.ToolTip="Comparación A/B"><Border Style="{StaticResource Dino2.CommandSeparator}"/>
          <Button x:Name="M2Keep" Click="Keep_Click" ToolTip="Conservar el resultado actual como original A">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="PinOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Conservar como A"/></StackPanel></Button>
          <Button Click="Remove_Click" ToolTip="Descartar el original A">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="PinOffOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Quitar A"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Style="{StaticResource Dino2.CommandGroup}" ToolTipService.ToolTip="Datos de entrada"><Border Style="{StaticResource Dino2.CommandSeparator}"/>
          <Button Click="Import_Click" ToolTip="Importar la configuración de un proyecto 2T monocilíndrico">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="Import" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Importar 2T…"/></StackPanel></Button>
        </StackPanel>
      </WrapPanel>
    </Border>
    <StackPanel DockPanel.Dock="Top" Margin="10,8,10,0">
      <Border Style="{StaticResource Dino2.Notice}">
        <DockPanel>
          <ic:PackIconMaterial Kind="AlertOutline" Width="16" Height="16" Margin="0,1,8,0" Foreground="{StaticResource Dino2.Brushes.WarningEdge}" VerticalAlignment="Top"/>
          <TextBlock TextWrapping="Wrap" Text="360° · cárteres separados · colectores compactos · pérdidas estimadas · validación experimental pendiente"/>
        </DockPanel>
      </Border>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Dino2.StatusBar}">
      <Grid Margin="10,3,6,3" MinHeight="28">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <mah:MetroProgressBar IsIndeterminate="True" Width="90" Height="4" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource Dino2.Brushes.Accent}" ToolTip="Calculando"
                          Visibility="{Binding IsEnabled, ElementName=M2Cancel, Converter={StaticResource Dino2.BoolToVisibility}}"/>
        <TextBlock x:Name="M2Status" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="Configurá y simulá el motor."/>
        <Button x:Name="M2Cancel" Grid.Column="2" Click="Cancel_Click" IsEnabled="False" Margin="8,0,0,0" ToolTip="Cancelar el cálculo en curso (Esc)">
          <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="Stop" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Cancelar"/></StackPanel></Button>
      </Grid>
    </Border>
    <Grid Margin="10,8,10,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="275" MinWidth="230"/><ColumnDefinition Width="8"/><ColumnDefinition MinWidth="380"/></Grid.ColumnDefinitions>
      <GridSplitter Grid.Column="1" ToolTip="Arrastrar para redimensionar"/>
      <DockPanel x:Name="Editor" Background="White">
        <ComboBox x:Name="EditorGroups" DockPanel.Dock="Top" Margin="8" AutomationProperties.Name="Grupo de configuración 2T multicilíndrico"/>
        <ContentControl x:Name="EditorContent"/>
      </DockPanel>
      <TabControl x:Name="Pages" Grid.Column="2">
        <TabItem Header="Curvas">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="7">
              <CheckBox x:Name="ByCylinder" Content="Ver contribuciones indicadas por cilindro" Checked="Curves_Changed" Unchecked="Curves_Changed" Margin="4"/>
              <d:ScientificPlot x:Name="PowerPlot" Height="230" Caption="Potencia [kW]"/>
              <d:ScientificPlot x:Name="TorquePlot" Height="230" Caption="Par [N·m]"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="RPM">
          <DataGrid x:Name="RunRows" IsReadOnly="True" CanUserAddRows="False" MinColumnWidth="100"/>
        </TabItem>
        <TabItem Header="Ciclo y barrido">
          <DockPanel Margin="6">
            <WrapPanel DockPanel.Dock="Top">
              <ComboBox x:Name="CycleSource" Width="108" SelectionChanged="Source_Changed" AutomationProperties.Name="Curva de ciclo"/>
              <ComboBox x:Name="CycleRpm" Width="90" Margin="3,0" SelectionChanged="Cycle_Changed" AutomationProperties.Name="RPM del ciclo"/>
              <Button x:Name="M2Trace" Content="CSV del ciclo…" Click="Trace_Click"/>
              <Button x:Name="M2Cylinders" Content="CSV por cilindro…" Click="Cylinders_Click"/>
            </WrapPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <DataGrid x:Name="CylinderRows" Height="143" IsReadOnly="True" CanUserAddRows="False" MinColumnWidth="100"/>
                <d:ScientificPlot x:Name="CylinderPlot" Height="201" Caption="Presión de cilindro [bar]" XLabel="Ángulo común [°]"/>
                <d:ScientificPlot x:Name="CasePlot" Height="201" Caption="Presión de cárter [bar]" XLabel="Ángulo común [°]"/>
                <d:ScientificPlot x:Name="IntakePlot" Height="210" Caption="Admisión, láminas y unión [bar]" XLabel="Ángulo común [°]"/>
                <d:ScientificPlot x:Name="ExhaustPlot" Height="210" Caption="Escape, lumbreras y unión [bar]" XLabel="Ángulo común [°]"/>
                <d:ScientificPlot x:Name="FlowPlot" Height="205" Caption="Caudal de transfers [g/s]" XLabel="Ángulo común [°]"/>
                <d:ScientificPlot x:Name="GasTorque" Height="205" Caption="Par instantáneo indicado de gases [N·m]" XLabel="Ángulo común [°]"/>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem Header="A/B">
          <DockPanel Margin="7">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Diferencias B−A en RPM comunes. Seleccioná una fila periódica para verificar su resolución." TextWrapping="Wrap" Margin="0,0,0,6"/>
              <WrapPanel>
                <Button x:Name="M2Compare" Content="Contrastar resolución" Click="Compare_Click"/>
                <Button x:Name="M2ExportAB" Content="CSV A/B…" Click="ExportAB_Click"/>
              </WrapPanel>
              <TextBlock x:Name="ContrastText" TextWrapping="Wrap" Margin="0,4"/>
            </StackPanel>
            <DataGrid x:Name="DiffRows" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="Diff_Changed"/>
          </DockPanel>
        </TabItem>
        <TabItem Header="Estudios">
          <DockPanel Margin="7">
            <StackPanel x:Name="StudyCommands" DockPanel.Dock="Top">
              <WrapPanel>
                <Button x:Name="M2TakeBase" Content="Tomar motor actual" Click="TakeBase_Click"/>
                <Button Content="Tomar A" Tag="A" Click="TakeBase_Click"/>
                <Button x:Name="M2StudyRun" Content="Ejecutar estudio" Click="Study_Click"/>
                <Button x:Name="M2Apply" Content="Aplicar como B" Click="Apply_Click"/>
                <Button x:Name="M2StudyCheck" Content="Contrastar objetivo" Click="StudyCheck_Click"/>
                <Button x:Name="M2StudyExport" Content="CSV estudio…" Click="StudyExport_Click"/>
              </WrapPanel>
              <TextBlock x:Name="StudyHint" TextWrapping="Wrap"/>
            </StackPanel>
            <TabControl x:Name="StudyPages">
              <TabItem Header="Plan">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="StudyEditor" Margin="5">
                    <TextBlock Text="Tomá una base. Los regímenes se fijan en el editor del motor." TextWrapping="Wrap"/>
                    <TextBlock Text="Parámetro · inicio · fin · incremento" FontWeight="SemiBold" Margin="0,8,0,3"/>
                    <StackPanel x:Name="StudyAxes"/>
                    <ComboBox x:Name="Objective" Width="280" HorizontalAlignment="Left" SelectionChanged="StudyInput_Changed"/>
                    <WrapPanel Margin="0,7">
                      <TextBlock Text="Banda RPM (opcional) " VerticalAlignment="Center"/>
                      <TextBox x:Name="BandStart" Width="75" TextChanged="StudyInput_Changed"/>
                      <TextBox x:Name="BandEnd" Width="75" TextChanged="StudyInput_Changed"/>
                    </WrapPanel>
                    <WrapPanel x:Name="LowFields" Visibility="Collapsed">
                      <TextBlock Text="Banda baja · inicio · fin · pérdida [N·m] " VerticalAlignment="Center"/>
                      <TextBox x:Name="LowStart" Width="63" TextChanged="StudyInput_Changed"/>
                      <TextBox x:Name="LowEnd" Width="63" TextChanged="StudyInput_Changed"/>
                      <TextBox x:Name="LowLoss" Text="0" Width="59" TextChanged="StudyInput_Changed"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,7">
                      <TextBlock Text="Trabajadores " VerticalAlignment="Center"/>
                      <ComboBox x:Name="Workers" Width="68"/>
                    </WrapPanel>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Clasificación">
                <DockPanel>
                  <TextBlock x:Name="StudyNote" DockPanel.Dock="Top" Margin="4" TextWrapping="Wrap"/>
                  <DataGrid x:Name="StudyRows" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="StudySelection_Changed"/>
                </DockPanel>
              </TabItem>
              <TabItem Header="Curvas del estudio">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <d:ScientificPlot x:Name="StudyPower" Caption="Potencia al cigüeñal estimada [kW]" Height="210"/>
                    <d:ScientificPlot x:Name="StudyTorque" Caption="Par al cigüeñal estimado [N·m]" Height="210"/>
                    <DataGrid x:Name="StudyRunRows" Height="165" IsReadOnly="True" CanUserAddRows="False"/>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</d:EngineDocument>
