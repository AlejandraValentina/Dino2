<local:EngineDocument x:Class="Dino2.Desktop.TwoStrokeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Dino2.Desktop"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:ic="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Style="{StaticResource Dino2.Window}" Title="Dino2 · Simulación 2T" Width="1260" Height="860" MinWidth="810" MinHeight="520">
  <mah:MetroWindow.IconTemplate>
    <DataTemplate><ic:PackIconMaterial Kind="Numeric2BoxOutline" Width="18" Height="18" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White"/></DataTemplate>
  </mah:MetroWindow.IconTemplate>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource Dino2.Brushes.Panel}" BorderBrush="{StaticResource Dino2.Brushes.Border}" BorderThickness="0,0,0,1">
      <WrapPanel x:Name="Commands" Style="{StaticResource Dino2.CommandBar}">
        <StackPanel Style="{StaticResource Dino2.CommandGroup}" ToolTipService.ToolTip="Archivo">
          <Button Click="Example_Click" ToolTip="Cargar el caso sintético 2T">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="FileDocumentOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Ejemplo"/></StackPanel></Button>
          <Button x:Name="OpenTwoStroke" Click="Open_Click" ToolTip="Abrir proyecto 2T (Ctrl+O)">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="FolderOpenOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Abrir…"/></StackPanel></Button>
          <Button x:Name="SaveTwoStroke" Click="Save_Click" ToolTip="Guardar proyecto 2T (Ctrl+S)">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="ContentSaveOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Guardar…"/></StackPanel></Button>
          <Button x:Name="ExportButton" Click="Export_Click" ToolTip="Exportar resultados 2T a CSV (Ctrl+E)">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="FileDelimitedOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Exportar…"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Style="{StaticResource Dino2.CommandGroup}" ToolTipService.ToolTip="Simulación"><Border Style="{StaticResource Dino2.CommandSeparator}"/>
          <Button x:Name="CalculateButton" Click="Calculate_Click" Style="{StaticResource Dino2.Button.Primary}" Margin="0" ToolTip="Simular el barrido de RPM (F5)">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="Play" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Simular 2T"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Style="{StaticResource Dino2.CommandGroup}" ToolTipService.ToolTip="Comparación A/B"><Border Style="{StaticResource Dino2.CommandSeparator}"/>
          <Button x:Name="KeepButton" Click="Keep_Click" ToolTip="Conservar el resultado actual como original A">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="PinOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Conservar como A"/></StackPanel></Button>
          <Button x:Name="RemoveOriginalButton" Click="RemoveOriginal_Click" ToolTip="Descartar el original A">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="PinOffOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Quitar A"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Style="{StaticResource Dino2.CommandGroup}" ToolTipService.ToolTip="Datos de entrada"><Border Style="{StaticResource Dino2.CommandSeparator}"/>
          <Button Click="ImportTransferContour_Click" ToolTip="Importar contorno de transfers. CSV height_mm,width_mm: altura sobre el techo y ancho agregado de apertura, en mm. El ancho integrado determina el área geométrica.">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="VectorPolyline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Contorno transfers…"/></StackPanel></Button>
          <Button Click="ImportExhaustContour_Click" ToolTip="Importar contorno de escape. CSV height_mm,width_mm: altura sobre el techo y ancho agregado de apertura, en mm.">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="VectorPolylineEdit" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Contorno escape…"/></StackPanel></Button>
          <Button x:Name="ImportTransferMapButton" Click="ImportTransferMap_Click" ToolTip="Importar mapa Cd para el transfer agregado 2T 0D. Requiere compatible_model=two-stroke-0d-isentropic-nozzle.">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="ChartLine" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Mapa Cd transfer…"/></StackPanel></Button>
          <Button x:Name="ImportExhaustMapButton" Click="ImportExhaustMap_Click" ToolTip="Importar mapa Cd para el escape 2T ports-v4 1D. Requiere compatible_model=ports-v4-equivalent-capacity-v1.">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="ChartBellCurve" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Mapa Cd escape…"/></StackPanel></Button>
          <Button x:Name="ImportReedMapButton" Click="ImportReedMap_Click" ToolTip="Importar mapa Cd de láminas cuasiestáticas o dinámicas, usando reed_open_area y el contrato ports-v4.">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="ChartAreaspline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Mapa Cd láminas…"/></StackPanel></Button>
          <Button x:Name="ClearCdMapsButton" Click="ClearMaps_Click" ToolTip="Quitar mapas Cd y volver al coeficiente constante.">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="Close" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Cd constante"/></StackPanel></Button>
          <Button x:Name="ViewCdMapsButton" Click="ViewMaps_Click" ToolTip="Ver puntos, origen, dirección y dominio de mapas Cd cargados.">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="TableEye" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Ver puntos Cd"/></StackPanel></Button>
        </StackPanel>
      </WrapPanel>
    </Border>
    <StackPanel DockPanel.Dock="Top" Margin="10,8,10,0">
      <Border Style="{StaticResource Dino2.Notice}">
        <DockPanel>
          <ic:PackIconMaterial Kind="AlertOutline" Width="16" Height="16" Margin="0,1,8,0" Foreground="{StaticResource Dino2.Brushes.WarningEdge}" VerticalAlignment="Top"/>
          <TextBlock TextWrapping="Wrap" Text="Monocilíndrico · láminas · cárter 0D · admisión y escape 1D · 360°. Ejemplo sintético. Wiebe prescrita, láminas cuasiestáticas y pérdidas estimadas. Resultados sin validación experimental."/>
        </DockPanel>
      </Border>
      <TextBlock x:Name="PortContourInfo" Margin="0,5,0,0" TextWrapping="Wrap" Style="{StaticResource Dino2.Muted}"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Dino2.StatusBar}">
      <Grid Margin="10,3,6,3" MinHeight="28">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <mah:MetroProgressBar IsIndeterminate="True" Width="90" Height="4" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource Dino2.Brushes.Accent}" ToolTip="Calculando"
                          Visibility="{Binding IsEnabled, ElementName=CancelButton, Converter={StaticResource Dino2.BoolToVisibility}}"/>
        <TextBlock x:Name="Status" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="Configurá el motor y simulá la curva."/>
        <Button x:Name="CancelButton" Grid.Column="2" Click="Cancel_Click" IsEnabled="False" Margin="8,0,0,0" ToolTip="Cancelar el cálculo en curso (Esc)">
          <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="Stop" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Cancelar"/></StackPanel></Button>
      </Grid>
    </Border>
    <Grid Margin="10,8,10,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="266" MinWidth="230"/><ColumnDefinition Width="8"/><ColumnDefinition MinWidth="380"/></Grid.ColumnDefinitions>
      <GridSplitter Grid.Column="1" ToolTip="Arrastrar para redimensionar"/>
      <DockPanel x:Name="Editor" Background="White">
        <TextBlock x:Name="GeometrySummary" DockPanel.Dock="Bottom" Margin="10" TextWrapping="Wrap"/>
        <ComboBox x:Name="ParametersGroup" DockPanel.Dock="Top" Margin="8" AutomationProperties.Name="Grupo de parámetros 2T"/>
        <ContentControl x:Name="ParametersContent"/>
      </DockPanel>
      <TabControl Grid.Column="2" x:Name="Analysis">
        <TabItem Header="Curvas">
          <DockPanel Margin="8">
            <TextBlock DockPanel.Dock="Top" Text="Puntos calculados · rueda: zoom · clic derecho: PNG." TextWrapping="Wrap"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MinHeight="272"><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <local:ScientificPlot x:Name="PowerPlot" Caption="Potencia [kW]"/>
              <local:ScientificPlot x:Name="TorquePlot" Grid.Row="1" Caption="Par [N·m]"/>
            </Grid></ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem Header="Resultados">
          <DataGrid x:Name="ResultGrid" CanUserAddRows="False" IsReadOnly="True" AutoGenerateColumns="True" AutomationProperties.Name="Resultados por RPM 2T"/>
        </TabItem>
        <TabItem x:Name="TwoStrokeABTab" Header="A / B">
          <DockPanel Margin="8">
            <TextBlock x:Name="ComparisonNotice" DockPanel.Dock="Top" Text="Diferencias B − A en regímenes comunes. Resolución de par y potencia al mismo régimen." TextWrapping="Wrap"/>
            <WrapPanel x:Name="ComparisonControls" DockPanel.Dock="Top" Margin="0,8,0,4">
              <ComboBox x:Name="ComparisonRpm" Width="90" AutomationProperties.Name="RPM de contraste A B"/>
              <Button x:Name="CheckTwoStrokeAB" Content="Verificar malla A/B" Click="VerifyAB_Click"/>
            </WrapPanel>
            <TextBlock x:Name="Resolution" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,3,0,7"/>
            <DataGrid x:Name="ComparisonGrid" CanUserAddRows="False" IsReadOnly="True" AutoGenerateColumns="True"/>
          </DockPanel>
        </TabItem>
        <TabItem x:Name="TwoStrokeTraceTab" Header="Ciclo y flujos">
          <DockPanel Margin="8">
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
              <TextBlock Text="RPM" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <ComboBox x:Name="TraceRpm" Width="86" AutomationProperties.Name="RPM del ciclo 2T" SelectionChanged="Trace_Changed"/>
              <Button x:Name="ExportCycleButton" Content="Exportar ciclo CSV…" Click="ExportTrace_Click"/>
            </WrapPanel>
            <TextBlock x:Name="TraceInfo" DockPanel.Dock="Top" TextWrapping="Wrap"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MinHeight="570"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <local:ScientificPlot x:Name="PressurePlot" Caption="Presión de volúmenes [bar abs]" XLabel="Ángulo desde PMS [°]"/>
              <local:ScientificPlot x:Name="PortsPlot" Grid.Row="1" Caption="Presión junto a láminas y escape [bar abs]" XLabel="Ángulo desde PMS [°]"/>
              <local:ScientificPlot x:Name="TemperaturePlot" Grid.Row="2" Caption="Temperatura [K]" XLabel="Ángulo desde PMS [°]"/>
              <local:ScientificPlot x:Name="FlowPlot" Grid.Row="3" Caption="Caudal másico [g/s]" XLabel="Ángulo desde PMS [°]"/>
            </Grid></ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem x:Name="TwoStrokeStudyTab" Header="Estudios 2T"><ContentControl x:Name="StudyHost"/></TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</local:EngineDocument>
