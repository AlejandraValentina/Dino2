<Window x:Class="Dino2.Desktop.MulticylinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dino2.Desktop"
        Title="Dino2 · Multicilíndrico 4T" Width="1320" Height="880" MinWidth="805" MinHeight="540"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Background="#F2F5F8">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Dino2  /  Multicilíndrico 4T" FontSize="23" FontWeight="SemiBold" Foreground="#142F43" Margin="0,0,0,6"/>
      <WrapPanel x:Name="Commands">
        <Button x:Name="MultiCalculate" Content="Simular" Click="Run_Click" Background="#176B8C" Foreground="White"/>
        <Button x:Name="MultiKeep" Content="Conservar como A" Click="Keep_Click"/>
        <Button Content="Quitar A" Click="Remove_Click"/>
        <Button x:Name="MultiOpen" Content="Abrir…" Click="Open_Click"/>
        <Button x:Name="MultiSave" Content="Guardar proyecto…" Click="Save_Click"/>
        <Button Content="Importar 4T monocilíndrico…" Click="Import_Click"/>
        <Button x:Name="MultiExport" Content="Exportar CSV…" Click="Export_Click"/>
      </WrapPanel>
      <Border Background="#FFF3CF" Padding="7" Margin="0,3,0,7">
        <TextBlock Text="Modelo 4T en línea con RPM impuesta. Pérdidas estimadas y colectores compactos. Sin validación experimental de motor." TextWrapping="Wrap"/>
      </Border>
    </StackPanel>
    <Grid DockPanel.Dock="Bottom" Margin="0,9,0,0" Background="#E1EAF0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="MultiStatusText" Margin="9" TextWrapping="Wrap" Text="Configurá el motor o simulá el ejemplo."/>
      <Button x:Name="MultiCancel" Grid.Column="1" Content="Cancelar" Click="Cancel_Click" IsEnabled="False" Margin="5"/>
    </Grid>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="302"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TabControl x:Name="Editor" Style="{StaticResource ScrollableSideTabs}"/>
      <TabControl x:Name="Pages" Grid.Column="2">
        <TabItem Header="Curvas">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="7">
              <CheckBox x:Name="CylinderCurveMode" Content="Ver contribuciones indicadas por cilindro en la curva actual"
                        Checked="CylinderCurve_Changed" Unchecked="CylinderCurve_Changed" Margin="3,3,0,4"/>
              <local:ScientificPlot x:Name="MultiPower" Height="246" Caption="Potencia [kW]"/>
              <local:ScientificPlot x:Name="MultiTorque" Height="246" Caption="Par [N·m]"/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="RPM">
          <DataGrid x:Name="MultiRows" IsReadOnly="True" CanUserAddRows="False" MinColumnWidth="106"/>
        </TabItem>
        <TabItem Header="Cilindros y ciclo">
          <DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Top">
              <WrapPanel>
                <TextBlock Text="Curva " VerticalAlignment="Center"/>
                <ComboBox x:Name="CycleSource" Width="105" SelectionChanged="Cycle_Changed"/>
                <TextBlock Text="  RPM " VerticalAlignment="Center"/>
                <ComboBox x:Name="MultiRpm" Width="86" SelectionChanged="Cycle_Changed"/>
                <Button x:Name="MultiTraceExport" Content="CSV del ciclo…" Click="ExportTrace_Click" Margin="8,0,0,0"/>
                <Button x:Name="MultiCylinderExport" Content="CSV por cilindro…" Click="ExportCylinders_Click"/>
              </WrapPanel>
              <TextBlock x:Name="CycleNotice" Margin="0,6,0,3" TextWrapping="Wrap"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <DataGrid x:Name="CylinderRows" Height="125" IsReadOnly="True" CanUserAddRows="False" MinColumnWidth="98"/>
                <local:ScientificPlot x:Name="CylinderPressure" Height="222" Caption="Presión de cilindro [bar]" XLabel="Ángulo común [°]"/>
                <local:ScientificPlot x:Name="IntakePressure" Height="217" Caption="Puertos y colector de admisión [bar]" XLabel="Ángulo común [°]"/>
                <local:ScientificPlot x:Name="ExhaustPressure" Height="217" Caption="Puertos y colector de escape [bar]" XLabel="Ángulo común [°]"/>
                <local:ScientificPlot x:Name="ShaftTorque" Height="215" Caption="Par instantáneo indicado del gas [N·m]" XLabel="Ángulo común [°]"/>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem Header="A/B">
          <DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Diferencias B−A en RPM comunes. Elegí una fila periódica para cotejar tres mallas." TextWrapping="Wrap" Margin="0,0,0,6"/>
              <WrapPanel>
                <Button x:Name="MultiCheck" Content="Contrastar resolución" Click="Compare_Click"/>
                <Button x:Name="MultiABExport" Content="CSV A/B…" Click="ExportComparison_Click"/>
              </WrapPanel>
              <TextBlock x:Name="ResolutionText" TextWrapping="Wrap" Margin="0,4"/>
            </StackPanel>
            <DataGrid x:Name="DifferenceRows" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="Difference_Changed" MinColumnWidth="100"/>
          </DockPanel>
        </TabItem>
        <TabItem Header="Estudios">
          <DockPanel Margin="8">
            <StackPanel DockPanel.Dock="Top" x:Name="StudyCommands">
              <WrapPanel>
                <Button x:Name="MultiStudyUseCurrent" Content="Tomar motor actual" Click="StudyTake_Click"/>
                <Button Content="Tomar A" Tag="A" Click="StudyTake_Click"/>
                <Button x:Name="MultiStudyStart" Content="Ejecutar estudio" Click="StudyRun_Click"/>
                <Button x:Name="MultiStudyApply" Content="Aplicar como B" Click="StudyApply_Click"/>
                <Button x:Name="MultiStudyCheck" Content="Contrastar objetivo" Click="StudyCheck_Click"/>
                <Button x:Name="MultiStudyExport" Content="CSV estudio…" Click="StudyExport_Click"/>
              </WrapPanel>
              <TextBlock x:Name="StudyBaseText" Text="Tomá la configuración base. El proyecto guarda el estudio ejecutado." TextWrapping="Wrap"/>
            </StackPanel>
            <TabControl x:Name="StudyPages" Margin="0,5,0,0">
              <TabItem Header="Plan">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="6" x:Name="StudyEditor">
                    <TextBlock Text="Parámetro · inicio · fin · incremento" FontWeight="SemiBold"/>
                    <StackPanel x:Name="AxisPanel"/>
                    <TextBlock Text="Objetivo al cigüeñal" FontWeight="SemiBold" Margin="0,10,0,3"/>
                    <ComboBox x:Name="ObjectiveBox" Width="285" HorizontalAlignment="Left" SelectionChanged="StudyInput_Changed"/>
                    <WrapPanel Margin="0,7,0,0">
                      <TextBlock Text="Banda de RPM (opcional)" VerticalAlignment="Center" Margin="0,0,7,0"/>
                      <TextBox x:Name="BandFrom" Width="75" TextChanged="StudyInput_Changed"/>
                      <TextBox x:Name="BandTo" Width="75" TextChanged="StudyInput_Changed"/>
                    </WrapPanel>
                    <WrapPanel x:Name="LowBand" Margin="0,7,0,0" Visibility="Collapsed">
                      <TextBlock Text="Banda baja · inicio · fin · pérdida admisible [N·m]" VerticalAlignment="Center"/>
                      <TextBox x:Name="LowFrom" Width="68" TextChanged="StudyInput_Changed"/>
                      <TextBox x:Name="LowTo" Width="68" TextChanged="StudyInput_Changed"/>
                      <TextBox x:Name="LowLoss" Width="62" Text="0" TextChanged="StudyInput_Changed"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,4">
                      <TextBlock Text="Trabajadores independientes " VerticalAlignment="Center"/>
                      <ComboBox x:Name="Workers" Width="72"/>
                    </WrapPanel>
                    <TextBlock x:Name="StudyCost" TextWrapping="Wrap" Margin="0,6,0,4"/>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
              <TabItem Header="Clasificación">
                <DockPanel Margin="4">
                  <TextBlock x:Name="StudyNote" DockPanel.Dock="Top" Margin="0,2,0,6" TextWrapping="Wrap"/>
                  <DataGrid x:Name="StudyRows" IsReadOnly="True" CanUserAddRows="False" SelectionChanged="StudySelection_Changed" MinColumnWidth="87"/>
                </DockPanel>
              </TabItem>
              <TabItem Header="Curvas y diagnósticos">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel Margin="5">
                    <local:ScientificPlot x:Name="StudyPower" Height="200" Caption="Potencia estimada al cigüeñal [kW]"/>
                    <local:ScientificPlot x:Name="StudyTorque" Height="200" Caption="Par estimado al cigüeñal [N·m]"/>
                    <DataGrid x:Name="StudyPointRows" Height="190" IsReadOnly="True" CanUserAddRows="False" MinColumnWidth="100"/>
                  </StackPanel>
                </ScrollViewer>
              </TabItem>
            </TabControl>
          </DockPanel>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
