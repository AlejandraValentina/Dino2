<mah:MetroWindow x:Class="Dino2.Desktop.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:ic="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Style="{StaticResource Dino2.Window}" Title="Dino2" Width="1440" Height="900" MinWidth="960" MinHeight="540">
  <mah:MetroWindow.IconTemplate>
    <DataTemplate><ic:PackIconMaterial Kind="Engine" Width="18" Height="18" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White"/></DataTemplate>
  </mah:MetroWindow.IconTemplate>
  <DockPanel>
    <Border x:Name="NavPane" DockPanel.Dock="Left" Width="176" Background="{StaticResource Dino2.Brushes.TitleBar}">
      <DockPanel>
        <TextBlock x:Name="NavHeader" DockPanel.Dock="Top" Text="MOTORES" Style="{StaticResource Dino2.NavHeader}"/>
        <TextBlock x:Name="NavFooter" DockPanel.Dock="Bottom" Style="{StaticResource Dino2.NavFooter}"
                   Text="Resultados de modelo. Validación experimental pendiente."/>
        <ListBox x:Name="EngineNav" Style="{StaticResource Dino2.NavList}" SelectionChanged="EngineNav_SelectionChanged"
                 AutomationProperties.Name="Tipo de motor">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ToolTip="{Binding Label}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ic:PackIconMaterial Kind="{Binding Icon}" Width="18" Height="18" Margin="0,1,10,0" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1" Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Dino2.BoolToVisibility}}">
                  <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Ellipse Grid.Column="2" Width="7" Height="7" Margin="6,6,0,0" VerticalAlignment="Top" Fill="#F2B530"
                         ToolTip="Cambios sin guardar" Visibility="{Binding IsDirty, Converter={StaticResource Dino2.BoolToVisibility}}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <ContentControl x:Name="Workspace" Focusable="False" IsTabStop="False"/>
  </DockPanel>
</mah:MetroWindow>
