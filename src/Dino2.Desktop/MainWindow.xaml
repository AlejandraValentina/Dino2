<local:EngineDocument x:Class="Dino2.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Dino2.Desktop"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:ic="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Style="{StaticResource Dino2.Window}" Title="Dino2 · Otto de referencia" Width="1200" Height="850" MinWidth="810" MinHeight="520">
  <mah:MetroWindow.IconTemplate>
    <DataTemplate><ic:PackIconMaterial Kind="SineWave" Width="18" Height="18" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White"/></DataTemplate>
  </mah:MetroWindow.IconTemplate>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource Dino2.Brushes.Panel}" BorderBrush="{StaticResource Dino2.Brushes.Border}" BorderThickness="0,0,0,1">
      <WrapPanel Style="{StaticResource Dino2.CommandBar}">
        <StackPanel Style="{StaticResource Dino2.CommandGroup}" ToolTipService.ToolTip="Archivo">
          <Button Click="Example_Click" ToolTip="Cargar el ejemplo ilustrativo">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="FileDocumentOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Ejemplo"/></StackPanel></Button>
          <Button x:Name="OpenButton" Click="Open_Click" ToolTip="Abrir configuración (Ctrl+O)">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="FolderOpenOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Abrir…"/></StackPanel></Button>
          <Button x:Name="SaveButton" Click="Save_Click" ToolTip="Guardar configuración (Ctrl+S)">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="ContentSaveOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Guardar como…"/></StackPanel></Button>
          <Button x:Name="ExportButton" Click="Export_Click" IsEnabled="False" ToolTip="Exportar resultados a CSV (Ctrl+E)">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="FileDelimitedOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Exportar CSV…"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Style="{StaticResource Dino2.CommandGroup}" ToolTipService.ToolTip="Cálculo"><Border Style="{StaticResource Dino2.CommandSeparator}"/>
          <Button x:Name="CalculateButton" Click="Calculate_Click" Style="{StaticResource Dino2.Button.Primary}" Margin="0" ToolTip="Calcular el ciclo (F5)">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="Calculator" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Calcular"/></StackPanel></Button>
        </StackPanel>
      </WrapPanel>
    </Border>
    <StackPanel DockPanel.Dock="Top" Margin="10,8,10,0">
      <Border Style="{StaticResource Dino2.Notice}">
        <DockPanel>
          <ic:PackIconMaterial Kind="AlertOutline" Width="16" Height="16" Margin="0,1,8,0" Foreground="{StaticResource Dino2.Brushes.WarningEdge}" VerticalAlignment="Top"/>
          <TextBlock TextWrapping="Wrap" Text="Ciclo Otto ideal de aire · Modelo v1. Resultado indicado ideal, sin validación experimental. Sin intercambio de gases, fricción ni combustión finita: par constante y potencia proporcional a RPM. No predice potencia al freno ni límites de giro."/>
        </DockPanel>
      </Border>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Dino2.StatusBar}">
      <Grid Margin="10,3,6,3" MinHeight="28">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Status" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="Configure el ciclo y pulse Calcular. El ejemplo es ilustrativo."/>
      </Grid>
    </Border>
    <Grid Margin="10,8,10,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="250" MinWidth="220"/><ColumnDefinition Width="8"/><ColumnDefinition MinWidth="380"/></Grid.ColumnDefinitions>
      <GridSplitter Grid.Column="1" ToolTip="Arrastrar para redimensionar"/>
      <Border Background="White" Padding="14" BorderBrush="{StaticResource Dino2.Brushes.Border}" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Configuración" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Presión absoluta al inicio de compresión. Calor por kg de aire; no es PCI de combustible." TextWrapping="Wrap" Foreground="{StaticResource Dino2.Brushes.TextMuted}" Margin="0,0,0,8"/>
            <StackPanel x:Name="Fields"/>
            <TextBlock Text="Acepta coma o punto decimal, sin separadores de miles. RPM enteras. Fin incluido si lo alcanza el paso. Máximo 2000 puntos." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Dino2.Brushes.TextMuted}" Margin="0,12,0,0"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <TabControl x:Name="ResultTabs" Grid.Column="2">
        <TabItem Header="Potencia y par">
          <Grid Background="White" Margin="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock x:Name="Summary" Margin="10" TextWrapping="Wrap" Text="Sin resultados. Todas las magnitudes se calculan a partir de la configuración."/>
            <local:CurvePlot x:Name="PowerPlot" Grid.Row="1" Power="True"/>
            <local:CurvePlot x:Name="TorquePlot" Grid.Row="2"/>
          </Grid>
        </TabItem>
        <TabItem Header="Tabla RPM">
          <DataGrid x:Name="ResultsTable" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="30" ColumnHeaderHeight="34">
            <DataGrid.Columns>
              <DataGridTextColumn Header="RPM" Binding="{Binding Rpm}" Width="*" MinWidth="100"/>
              <DataGridTextColumn Header="Par indicado [N·m]" Binding="{Binding IndicatedTorqueNm, StringFormat=F4}" Width="*" MinWidth="160"/>
              <DataGridTextColumn Header="Potencia indicada [W]" Binding="{Binding IndicatedPowerW, StringFormat=F4}" Width="*" MinWidth="180"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="Estados y balance">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Background="White">
            <TextBlock x:Name="Balance" Text="Calcule para inspeccionar el ciclo." TextWrapping="Wrap" Margin="16"/>
            <DataGrid x:Name="StatesTable" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="30" ColumnHeaderHeight="34">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Estado" Binding="{Binding Number}" Width="*" MinWidth="65"/>
                <DataGridTextColumn Header="Volumen [m³]" Binding="{Binding VolumeM3, StringFormat=G7}" Width="*" MinWidth="150"/>
                <DataGridTextColumn Header="T [K]" Binding="{Binding TemperatureK, StringFormat=F3}" Width="*" MinWidth="110"/>
                <DataGridTextColumn Header="p absoluta [Pa]" Binding="{Binding PressurePa, StringFormat=F2}" Width="*" MinWidth="150"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="1→2: compresión isentrópica; 2→3: calor a volumen constante; 3→4: expansión isentrópica; 4→1: rechazo de calor a volumen constante. Un ciclo por cada dos revoluciones." TextWrapping="Wrap" Margin="16"/>
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</local:EngineDocument>
