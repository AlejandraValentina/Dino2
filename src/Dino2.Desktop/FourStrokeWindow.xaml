<Window x:Class="Dino2.Desktop.FourStrokeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Dino2.Desktop"
        Title="Dino2 · Simulación 4T" Width="1350" Height="900" MinWidth="810" MinHeight="520" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Background="#F2F5F8">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Dino2  /  Motor 4T" FontSize="23" FontWeight="SemiBold" Foreground="#142F43" Margin="0,0,0,6"/>

      <WrapPanel x:Name="Commands" Margin="0,0,0,10">
        <Button Content="Ejemplo" Click="Example_Click"/>
        <Button Content="Abrir…" Click="Open_Click"/>
        <Button Content="Guardar proyecto…" Click="Save_Click"/>
        <Button x:Name="CalculateButton" Content="Simular" Click="Simulate_Click" Background="#176B8C" Foreground="White"/>
        <Button x:Name="KeepOriginalButton" Content="Conservar como A" Click="Keep_Click" IsEnabled="False"/>
        <Button Content="Quitar A" Click="RemoveOriginal_Click"/>
        <Button x:Name="ExportButton" Content="Exportar CSV…" Click="Export_Click" IsEnabled="False"/>
        <Button x:Name="TwoStrokeButton" Content="Motor 2T" Click="TwoStroke_Click"/>
        <Button x:Name="OttoReferenceButton" Content="Otto de referencia" Click="Otto_Click"/>
        <Button x:Name="MulticylinderButton" Content="Multicilíndrico 4T" Click="Multicylinder_Click"/>
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <TextBlock Text="Modelo físico: " VerticalAlignment="Center"/>
        <ComboBox x:Name="PhysicsModel" Width="395" SelectionChanged="PhysicsModel_Changed">
          <ComboBoxItem Content="Pseudoaire v1 · referencia"/>
          <ComboBoxItem Content="Iso-octano v2 · Wiebe prescrita"/>
          <ComboBoxItem Content="Iso-octano v2 · Wiebe escalada (estimada)"/>
          <ComboBoxItem Content="Iso-octano v3 · Equilibrio UV · Wiebe escalada"/>
          <ComboBoxItem Content="Iso-octano v3 · Equilibrio UV · Wiebe prescrita"/>
          <ComboBoxItem Content="v4 · 1D primer orden · Wiebe prescrita"/>
          <ComboBoxItem Content="v4 · 1D primer orden · Wiebe escalada"/>
          <ComboBoxItem Content="v4 · Conductos MUSCL · Wiebe prescrita"/>
          <ComboBoxItem Content="v4 · Conductos MUSCL · Wiebe escalada"/>
        </ComboBox>
      </StackPanel>
      <Border Background="#FFF3CF" Padding="8" Margin="0,0,0,8">
        <TextBlock x:Name="ModelNotice" TextWrapping="Wrap" Text="Predicción aproximada sin validación experimental de motor. Revise hipótesis y procedencia de los parámetros."/>
      </Border>
    </StackPanel>
    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0" Background="#E1EAF0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Status" Margin="10" TextWrapping="Wrap" Text="Configure el motor y pulse Simular. El ejemplo es sintético."/>
      <Button x:Name="CancelButton" Grid.Column="1" Content="Cancelar" Click="Cancel_Click" IsEnabled="False" Margin="8"/>
    </Grid>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="274"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TabControl x:Name="ParameterTabs" TabStripPlacement="Left" Style="{StaticResource ScrollableSideTabs}"/>
      <TabControl x:Name="AnalysisTabs" Grid.Column="2">
        <TabItem Header="Curvas">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Background="White" Margin="8" MinHeight="335">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock x:Name="Summary" Text="Sin simulación para la configuración actual." TextWrapping="Wrap" Margin="8"/>
            <TextBlock Grid.Row="1" Text="Puntos calculados · rueda: zoom · clic derecho: PNG." TextWrapping="Wrap" Margin="8,0,8,8"/>
            <local:ScientificPlot x:Name="PowerChart" Grid.Row="2"/>
            <local:ScientificPlot x:Name="TorqueChart" Grid.Row="3"/>
          </Grid></ScrollViewer>
        </TabItem>
        <TabItem Header="Resultados">
          <DataGrid x:Name="ResultGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" MinColumnWidth="105" ColumnHeaderHeight="35" RowHeight="30"/>
        </TabItem>
        <TabItem Header="A / B">
          <DockPanel Background="White">
            <TextBlock x:Name="ComparisonNotice" DockPanel.Dock="Top" Margin="12" TextWrapping="Wrap" Text="Simule y conserve A. Modifique un parámetro y vuelva a simular para comparar B − A. El original no cambia al editar."/>
            <StackPanel x:Name="ResolutionPanel" DockPanel.Dock="Top" Margin="12,0,12,8" Visibility="Collapsed">
              <WrapPanel>
                <ComboBox x:Name="ResolutionRpm" Width="85" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Button x:Name="ResolveMeshButton" Content="Comprobar malla A/B" Click="ResolveMesh_Click"/>
              </WrapPanel>
              <TextBlock x:Name="ResolutionText" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
            <DataGrid x:Name="ComparisonGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" MinColumnWidth="125" RowHeight="30" ColumnHeaderHeight="35"/>
          </DockPanel>
        </TabItem>
        <TabItem Header="Ciclo">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Background="White" Margin="8" MinHeight="530">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="8">
              <TextBlock Text="RPM del ciclo actual: " VerticalAlignment="Center"/>
              <ComboBox x:Name="TraceRpm" Width="120" SelectionChanged="TraceRpm_Changed"/>
            </StackPanel>
            <local:ScientificPlot x:Name="PressureChart" Grid.Row="1"/>
            <local:ScientificPlot x:Name="PvChart" Grid.Row="2"/>
            <local:ScientificPlot x:Name="TemperatureChart" Grid.Row="3"/>
            <TextBlock x:Name="CycleDiagnostics" Grid.Row="4" Margin="8" TextWrapping="Wrap"/>
          </Grid></ScrollViewer>
        </TabItem>
        <TabItem Header="Conductos">
          <DockPanel Background="White" Margin="8">
            <TextBlock x:Name="PortCaption" DockPanel.Dock="Top" Margin="8" TextWrapping="Wrap"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MinHeight="295">
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <local:ScientificPlot x:Name="PortChart"/>
              <local:ScientificPlot x:Name="FlowChart" Grid.Row="1"/>
            </Grid></ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem x:Name="StudyTab" Header="Estudios">
          <local:StudyPanel x:Name="Studies"/>
        </TabItem>
        <TabItem Header="Diagnósticos">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Diagnostics" Margin="16" TextWrapping="Wrap" Text="Se mostrarán balances, convergencia, tiempos y limitaciones del cálculo."/></ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
