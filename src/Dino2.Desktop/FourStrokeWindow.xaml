<local:EngineDocument x:Class="Dino2.Desktop.FourStrokeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Dino2.Desktop"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:ic="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Style="{StaticResource Dino2.Window}" Title="Dino2 · Simulación 4T" Width="1350" Height="900" MinWidth="810" MinHeight="520">
  <mah:MetroWindow.IconTemplate>
    <DataTemplate><ic:PackIconMaterial Kind="Engine" Width="18" Height="18" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White"/></DataTemplate>
  </mah:MetroWindow.IconTemplate>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="{StaticResource Dino2.Brushes.Panel}" BorderBrush="{StaticResource Dino2.Brushes.Border}" BorderThickness="0,0,0,1">
      <WrapPanel x:Name="Commands" Style="{StaticResource Dino2.CommandBar}">
        <StackPanel Style="{StaticResource Dino2.CommandGroup}" ToolTipService.ToolTip="Archivo">
          <Button Click="Example_Click" ToolTip="Cargar el caso sintético de ejemplo">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="FileDocumentOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Ejemplo"/></StackPanel></Button>
          <Button x:Name="OpenButton" Click="Open_Click" ToolTip="Abrir proyecto (Ctrl+O)">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="FolderOpenOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Abrir…"/></StackPanel></Button>
          <Button x:Name="SaveButton" Click="Save_Click" ToolTip="Guardar proyecto (Ctrl+S)">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="ContentSaveOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Guardar…"/></StackPanel></Button>
          <Button x:Name="ExportButton" Click="Export_Click" IsEnabled="False" ToolTip="Exportar resultados a CSV (Ctrl+E)">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="FileDelimitedOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Exportar…"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Style="{StaticResource Dino2.CommandGroup}" ToolTipService.ToolTip="Simulación"><Border Style="{StaticResource Dino2.CommandSeparator}"/>
          <StackPanel x:Name="PhysicsModel" Orientation="Horizontal" VerticalAlignment="Center">
            <ComboBox x:Name="ModelFamily" Width="240" Margin="0,0,4,0" SelectionChanged="ModelSelection_Changed"
                      ToolTip="Modelo físico: termoquímica y tratamiento de los conductos" AutomationProperties.Name="Modelo físico">
              <ComboBoxItem Content="Pseudoaire v1 · referencia"/>
              <ComboBoxItem Content="Iso-octano v2 · productos congelados"/>
              <ComboBoxItem Content="Iso-octano v3 · equilibrio UV"/>
              <ComboBoxItem Content="v4 · conductos 1D primer orden"/>
              <ComboBoxItem Content="v4 · conductos 1D MUSCL"/>
            </ComboBox>
            <ComboBox x:Name="BurnLawChoice" Width="196" Margin="0,0,6,0" SelectionChanged="ModelSelection_Changed"
                      ToolTip="Ley de liberación de calor. El modelo v1 usa siempre Wiebe prescrita." AutomationProperties.Name="Ley de combustión">
              <ComboBoxItem Content="Wiebe prescrita"/>
              <ComboBoxItem Content="Wiebe escalada (estimada)"/>
            </ComboBox>
          </StackPanel>
          <Button x:Name="CalculateButton" Click="Simulate_Click" Style="{StaticResource Dino2.Button.Primary}" Margin="0" ToolTip="Simular el barrido de RPM (F5)">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="Play" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Simular"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Style="{StaticResource Dino2.CommandGroup}" ToolTipService.ToolTip="Comparación A/B"><Border Style="{StaticResource Dino2.CommandSeparator}"/>
          <Button x:Name="KeepOriginalButton" Click="Keep_Click" IsEnabled="False" ToolTip="Conservar el resultado actual como original A">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="PinOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Conservar como A"/></StackPanel></Button>
          <Button Click="RemoveOriginal_Click" ToolTip="Descartar el original A">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="PinOffOutline" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Quitar A"/></StackPanel></Button>
        </StackPanel>
        <StackPanel Style="{StaticResource Dino2.CommandGroup}" ToolTipService.ToolTip="Datos de entrada"><Border Style="{StaticResource Dino2.CommandSeparator}"/>
          <Button Click="ImportIntakeLift_Click"
                  ToolTip="Importar alzada de admisión. CSV con columnas crank_angle_deg,lift_mm; ángulo de cigüeñal en 0–720°, alzada en mm, alineada a TDC de combustión. Se interpola linealmente.">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="ChartBellCurveCumulative" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Alzada adm.…"/></StackPanel></Button>
          <Button Click="ImportExhaustLift_Click"
                  ToolTip="Importar alzada de escape. CSV con columnas crank_angle_deg,lift_mm; ángulo de cigüeñal en 0–720°, alzada en mm. Se interpola linealmente.">
            <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="ChartBellCurve" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Alzada esc.…"/></StackPanel></Button>
        </StackPanel>
      </WrapPanel>
    </Border>
    <StackPanel DockPanel.Dock="Top" Margin="10,8,10,0">
      <Border Style="{StaticResource Dino2.Notice}">
        <DockPanel>
          <ic:PackIconMaterial Kind="AlertOutline" Width="16" Height="16" Margin="0,1,8,0" Foreground="{StaticResource Dino2.Brushes.WarningEdge}" VerticalAlignment="Top"/>
          <TextBlock x:Name="ModelNotice" TextWrapping="Wrap" Text="Predicción aproximada sin validación experimental de motor. Revise hipótesis y procedencia de los parámetros."/>
        </DockPanel>
      </Border>
      <TextBlock x:Name="ValveProfileInfo" Margin="0,5,0,0" TextWrapping="Wrap" Style="{StaticResource Dino2.Muted}"/>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Style="{StaticResource Dino2.StatusBar}">
      <Grid Margin="10,3,6,3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <mah:MetroProgressBar IsIndeterminate="True" Width="90" Height="4" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource Dino2.Brushes.Accent}" ToolTip="Calculando"
                          Visibility="{Binding IsEnabled, ElementName=CancelButton, Converter={StaticResource Dino2.BoolToVisibility}}"/>
        <TextBlock x:Name="Status" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" Text="Configure el motor y pulse Simular. El ejemplo es sintético."/>
        <Button x:Name="CancelButton" Grid.Column="2" Click="Cancel_Click" IsEnabled="False" Margin="8,0,0,0" ToolTip="Cancelar el cálculo en curso (Esc)">
          <StackPanel Orientation="Horizontal"><ic:PackIconMaterial Kind="Stop" Style="{StaticResource Dino2.ToolIcon}"/><TextBlock Text="Cancelar"/></StackPanel></Button>
      </Grid>
    </Border>
    <Grid Margin="10,8,10,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="230"/><ColumnDefinition Width="8"/><ColumnDefinition MinWidth="380"/></Grid.ColumnDefinitions>
      <TabControl x:Name="ParameterTabs" TabStripPlacement="Left" Style="{StaticResource ScrollableSideTabs}"/>
      <GridSplitter Grid.Column="1" ToolTip="Arrastrar para redimensionar"/>
      <TabControl x:Name="AnalysisTabs" Grid.Column="2">
        <TabItem Header="Curvas">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Background="White" Margin="8" MinHeight="335">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock x:Name="Summary" Text="Sin simulación para la configuración actual." TextWrapping="Wrap" Margin="8"/>
            <TextBlock Grid.Row="1" Text="Puntos calculados · rueda: zoom · clic derecho: PNG." TextWrapping="Wrap" Margin="8,0,8,8"/>
            <local:ScientificPlot x:Name="PowerChart" Grid.Row="2"/>
            <local:ScientificPlot x:Name="TorqueChart" Grid.Row="3"/>
          </Grid></ScrollViewer>
        </TabItem>
        <TabItem Header="Resultados">
          <DataGrid x:Name="ResultGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" MinColumnWidth="105" ColumnHeaderHeight="35" RowHeight="30"/>
        </TabItem>
        <TabItem Header="A / B">
          <DockPanel Background="White">
            <TextBlock x:Name="ComparisonNotice" DockPanel.Dock="Top" Margin="12" TextWrapping="Wrap" Text="Simule y conserve A. Modifique un parámetro y vuelva a simular para comparar B − A. El original no cambia al editar."/>
            <StackPanel x:Name="ResolutionPanel" DockPanel.Dock="Top" Margin="12,0,12,8" Visibility="Collapsed">
              <WrapPanel>
                <ComboBox x:Name="ResolutionRpm" Width="85" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Button x:Name="ResolveMeshButton" Content="Comprobar malla A/B" Click="ResolveMesh_Click"/>
              </WrapPanel>
              <TextBlock x:Name="ResolutionText" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
            <DataGrid x:Name="ComparisonGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False" MinColumnWidth="125" RowHeight="30" ColumnHeaderHeight="35"/>
          </DockPanel>
        </TabItem>
        <TabItem Header="Ciclo">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Background="White" Margin="8" MinHeight="530">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="8">
              <TextBlock Text="RPM del ciclo actual: " VerticalAlignment="Center"/>
              <ComboBox x:Name="TraceRpm" Width="120" SelectionChanged="TraceRpm_Changed"/>
            </StackPanel>
            <local:ScientificPlot x:Name="PressureChart" Grid.Row="1"/>
            <local:ScientificPlot x:Name="PvChart" Grid.Row="2"/>
            <local:ScientificPlot x:Name="TemperatureChart" Grid.Row="3"/>
            <TextBlock x:Name="CycleDiagnostics" Grid.Row="4" Margin="8" TextWrapping="Wrap"/>
          </Grid></ScrollViewer>
        </TabItem>
        <TabItem Header="Conductos">
          <DockPanel Background="White" Margin="8">
            <TextBlock x:Name="PortCaption" DockPanel.Dock="Top" Margin="8" TextWrapping="Wrap"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MinHeight="295">
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <local:ScientificPlot x:Name="PortChart"/>
              <local:ScientificPlot x:Name="FlowChart" Grid.Row="1"/>
            </Grid></ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem x:Name="StudyTab" Header="Estudios">
          <local:StudyPanel x:Name="Studies"/>
        </TabItem>
        <TabItem Header="Diagnósticos">
          <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Diagnostics" Margin="16" TextWrapping="Wrap" Text="Se mostrarán balances, convergencia, tiempos y limitaciones del cálculo."/></ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</local:EngineDocument>
